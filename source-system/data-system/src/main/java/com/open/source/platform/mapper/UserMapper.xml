<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.open.source.platform.mapper.UserMapper">
    <select id="selectUser" resultType="com.open.source.platform.entity.User">
        select username ,telephone from user

    </select>
    <delete id="deleteUser">
        delete from user where id = #{id}
    </delete>
</mapper>